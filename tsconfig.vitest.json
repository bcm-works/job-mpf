{
  "extends": "./tsconfig.app.json",

  // Include test files and all source files so that .vue files imported by tests
  // are explicitly listed, as required by composite mode.
  "include": ["src/**/*", "src/**/*.vue", "env.d.ts"],
  "exclude": [],

  "compilerOptions": {
    "composite": true,

    // Vitest runs in a different environment than the application code.
    // Adjust lib and types accordingly.
    "lib": [],
    "types": ["node", "jsdom"],

    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo"
  }
}
