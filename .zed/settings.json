{
  "languages": {
    "JSON": {
      "format_on_save": "off",
      "auto_indent_on_paste": false,
      "auto_indent": "none",
      "ensure_final_newline_on_save": false
    },
    "JSONC": {
      "format_on_save": "off",
      "auto_indent_on_paste": false,
      "auto_indent": "none",
      "ensure_final_newline_on_save": false
    },
    "JavaScript": {
      "language_servers": [
        "typescript-language-server",
        "!deno",
        "!vtsls",
        "!eslint",
      ],
      "formatter": "language_server",
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      }
    },
    "CSS": {
      "format_on_save": "off",
      "auto_indent_on_paste": false,
      "auto_indent": "none",
      "ensure_final_newline_on_save": false
    },
    "TypeScript": {
      "language_servers": [
        "typescript-language-server",
        "!deno",
        "!vtsls",
        "!eslint",
      ],
      "formatter": "language_server",
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      }
    },
    "TSX": {
      "language_servers": [
        "eslint",
        "!deno",
        "!typescript-language-server",
        "!vtsls",
      ],
      "formatter": "language_server",
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      }
    },
    "Vue.js": {
      "language_servers": [
        "vue",
        "eslint",
      ],
      "formatter": "language_server",
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      }
    },
    "YAML": {
      "format_on_save": "off",
      "auto_indent_on_paste": false,
      "auto_indent": "none",
      "ensure_final_newline_on_save": true,
      "language_servers": [
        "!json-language-server"
      ]
    },
  },
  "lsp": {
    "deno": {
      "settings": {
        "deno": {
          "enable": true,
          "lint": true,
          "config": "./deno.json",
          "importMap": "./deno.json",
        },
      },
    }
  },
}
