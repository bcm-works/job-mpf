{
  "nodeModulesDir": "auto",
  "preferPackageJson": false,
  "minimumDependencyAge": 7,
  "lock": true,
  "tasks": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck"
  },
  "imports": {
    "@iconify-json/lucide": "npm:@iconify-json/lucide@^1.2.127",
    "@iconify-json/simple-icons": "npm:@iconify-json/simple-icons@^1.2.94",
    "@nuxt/ui": "npm:@nuxt/ui@^4.11.0",
    "nuxt": "npm:nuxt@^4.5.2",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "@nuxt/eslint": "npm:@nuxt/eslint@^1.17.0",
    "eslint": "npm:eslint@^10.9.1",
    "typescript": "npm:typescript@^6.0.3",
    "vue-tsc": "npm:vue-tsc@^3.3.11"
  }
}
