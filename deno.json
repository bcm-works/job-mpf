{
  "nodeModulesDir": "auto",
  "preferPackageJson": false,
  "minimumDependencyAge": 7,
  "lock": true,
  "exclude": [
    "dist/*",
    "node_modules/*"
  ],
  "tasks": {
    "build": "NODE_OPTIONS=--max-old-space-size=4096 nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint --fix .",
    "typecheck": "nuxt typecheck",
    "deps": "deno update"
  },
  "imports": {
    "@/*": "./src/*",
    "@deno/kv": "npm:@deno/kv@^0.14.0",
    "@iconify-json/lucide": "npm:@iconify-json/lucide@^1.2.129",
    "@nuxt/ui": "npm:@nuxt/ui@^4.11.0",
    "nuxt": "npm:nuxt@^4.5.2",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "@nuxt/eslint": "npm:@nuxt/eslint@^1.17.0",
    "eslint": "npm:eslint@^10.10.0",
    "typescript": "npm:typescript@^6.0.3",
    "vue-router": "npm:vue-router@^5.3.1",
    "vue-tsc": "npm:vue-tsc@^3.3.11"
  },
  "allowScripts": {
    "allow": [],
    "deny": ["npm:esbuild@0.27.7", "npm:esbuild@0.28.2", "npm:unrs-resolver@1.12.2", "npm:vue-demi@0.14.10"]
  }
}
